TERMOYAZD_ENV=production
# Exact frontend origin, no trailing slash; never a wildcard.
TERMOYAZD_CORS_ORIGINS=https://YOUR-REAL-FRONTEND.vercel.app
# Exact API hostname. Render supplies RENDER_EXTERNAL_HOSTNAME automatically.
# TERMOYAZD_ALLOWED_HOSTS=YOUR-REAL-RENDER-SERVICE.onrender.com
TERMOYAZD_MAX_BODY_BYTES=16384
TERMOYAZD_MAX_CALCULATIONS=2
PORT=8000
