# Recommended self-contained edition: no Python service and no API URL needed.
VITE_BROWSER_ENGINE=true

# Alternative Vercel + Render edition (set BOTH in Vercel project settings):
# VITE_BROWSER_ENGINE=false
# VITE_API_BASE_URL=https://YOUR-REAL-RENDER-SERVICE.onrender.com
# This must be the actual API origin, no /api suffix or trailing path.
# VITE_* values are public build-time settings, never secrets.
